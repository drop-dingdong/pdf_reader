target/
# PDFium 预编译动态库（用 scripts/fetch-pdfium.sh 获取，不入库）
vendor/

# 回放器样本（现场生成，不入库）
scripts/replay/*.pdf
scripts/replay/*.pdf.json
# 标注图层 sidecar（手工测试/回放会生成，不入库）
scripts/replay/*.annot.json
# 原地写回的备份（手工测试会生成，不入库）
scripts/replay/*.bak-*

# 性能基线（每台机器自己记录，不入库）
perf/*
!perf/baseline/
!perf/baseline/*.json

# 打包产物
dist/
